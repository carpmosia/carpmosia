<BoxContainer xmlns="https://spacestation14.io" xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls" Orientation="Vertical" SeparationOverride="9">
    <Label
        Name="NoPatientPlaceholder"
        Text="{Loc health-analyzer-window-no-patient-data-text}"
        HorizontalExpand="True"
        VerticalExpand="True"
        Align="Center"/>

    <BoxContainer Name="Sections"
                  Orientation="Horizontal"
                  Visible="False"
                  Margin="10"
                  SeparationOverride="16">
        <BoxContainer Name="VitalSection"
                      VerticalExpand="True"
                      Orientation="Vertical"
                      MinWidth="250"
                      MaxWidth="400">

            <BoxContainer Orientation="Horizontal"
                          SeparationOverride="10"
                          Margin="8 0 0 8">
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <PanelContainer SetSize="32 32">
                        <SpriteView OverrideDirection="South" Scale="2 2" Name="PatientView" SetSize="32 32" />
                        <TextureRect Name="OutOfRange" Access="Public" SetSize="32 32" Visible="false" Stretch="KeepAspectCentered" TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png"/>
                    </PanelContainer>
                 </BoxContainer>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <Label Name="NameLabel" />
                    <Label Name="SpeciesLabel" VerticalAlignment="Top" StyleClasses="LabelSubText" />
                </BoxContainer>


            </BoxContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="20" Margin="0 0 0 4">

                <BoxContainer Orientation="Vertical" >
                    <Label StyleClasses="field-label" Text="{Loc 'offbrand-vitals-brain-activity'}" />
                    <Label Name="BrainActivityValue" StyleClasses="field-value" />
                    <Label Name="SpO2Label" StyleClasses="field-label" />
                    <Label Name="SpO2Value" StyleClasses="field-value" />
                    <Label StyleClasses="field-label" Text="{Loc 'offbrand-vitals-blood-volume'}" />
                    <RichTextLabel Name="BloodVolumeValue" StyleClasses="field-value" />
                </BoxContainer>

                <BoxContainer Orientation="Vertical" >

                    <Label StyleClasses="field-label" Text="{Loc 'offbrand-vitals-respiratory-rate'}" />
                    <RichTextLabel Name="RespiratoryRateValue" StyleClasses="field-value" />
                    <Label Name="EtCO2Label" StyleClasses="field-label" />
                    <RichTextLabel Name="EtCO2Value" StyleClasses="field-value" />
                </BoxContainer>

                <BoxContainer Orientation="Vertical" >
                    <Label StyleClasses="field-label" Text="{Loc 'offbrand-vitals-heart-rate'}" />
                    <RichTextLabel Name="HeartRateValue" StyleClasses="field-value" />
                    <Label StyleClasses="field-label" Text="{Loc 'offbrand-vitals-blood-pressure'}" />
                    <RichTextLabel Name="BloodPressureValue" StyleClasses="field-value" />
                </BoxContainer>

            </BoxContainer>

        </BoxContainer>
        <BoxContainer Name="WoundSection"
                      VerticalExpand="True"
                      Orientation="Vertical"
                      MinWidth="250"
                      MaxWidth="400">
            <BoxContainer Orientation="Horizontal">
                <BoxContainer Name="AlertsContainer"
                                Visible="False"
                                Orientation="Vertical"
                                VerticalExpand="True"
                                HorizontalExpand="True"
                                />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</BoxContainer>
