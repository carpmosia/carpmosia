<!-- Carpmosia-rework - Cargo bookkeeping -->
<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Margin="10 10 10 0"
              HorizontalExpand="True"
              Visible="True">
    <PanelContainer StyleClasses="BackgroundPanel" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True" Margin="0 5 0 7">
            <BoxContainer Orientation="Horizontal">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <RichTextLabel Name="RewardLabel"/>
                    <RichTextLabel Name="ClaimedBy" />
                    <RichTextLabel Name="DeliveryStatus"/>
                </BoxContainer>
                <Control MinWidth="10"/>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="PrintButton"
                                Text="{Loc 'bounty-console-label-button-text'}"
                                HorizontalExpand="True"
                                HorizontalAlignment="Stretch"
                                StyleClasses="OpenBoth"/>
                        <Button Name="SkipButton"
                                Text="{Loc 'bounty-console-skip-button-text'}"
                                MinWidth="90"
                                HorizontalExpand="False"
                                HorizontalAlignment="Right"
                                StyleClasses="OpenLeft"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="ClaimButton"
                                MinWidth="90"
                                HorizontalExpand="True"
                                HorizontalAlignment="Stretch"
                                StyleClasses="OpenRight"/>
                        <OptionButton Name="DeliveryButton"
                                ToolTip="{Loc 'bounty-console-delivery-status-button-tooltip'}"
                                MinWidth="130"
                                HorizontalExpand="False"
                                HorizontalAlignment="Right"
                                StyleClasses="OpenBoth"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <controls:Separator StyleClasses="LowDivider" Margin="0 5 0 3"/>
            <RichTextLabel Name="ManifestLabel"/>
            <RichTextLabel Name="DescriptionLabel"/>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
